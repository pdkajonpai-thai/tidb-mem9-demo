# Template for what to paste into Streamlit Community Cloud > App settings > Secrets.
# Keep real values only in .streamlit/secrets.toml (local, excluded from git) or the Cloud Secrets screen.
# Top-level keys are also exposed as environment variables, which core/config.py reads directly.

TIDB_HOST = "gateway01.ap-northeast-1.prod.aws.tidbcloud.com"
TIDB_PORT = "4000"
TIDB_USER = ""
TIDB_PASSWORD = ""
TIDB_DATABASE = "invest_demo"

MEM9_API_URL = "https://api.mem9.ai"
MEM9_API_KEY = ""

ANTHROPIC_API_KEY = ""
LLM_MODEL = "claude-haiku-5-5"

ADMIN_EMAILS = ""            # e.g. "you@example.com,teammate@pingcap.com"

LANGSMITH_TRACING = "false"

# Google sign-in (st.login). Must be inside the [auth] section (not exposed as environment variables).
[auth]
redirect_uri = "https://<app-name>.streamlit.app/oauth2callback"   # local: http://localhost:8501/oauth2callback
cookie_secret = ""           # long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
client_id = ""               # Google Cloud Console > APIs & Services > Credentials > OAuth client ID
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
