# Run cp .env.example .env, then fill in the values. .env is not committed to git.

# TiDB Cloud Starter (cluster page → Connect → General)
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=invest_demo

# mem9 Hosted (the id in the response to curl -sX POST https://api.mem9.ai/v1alpha1/mem9s)
MEM9_API_URL=https://api.mem9.ai
MEM9_API_KEY=

# Claude API
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Optional: LangSmith tracing (when on, prompts and responses are sent to LangSmith)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tidb-mem9-demo

# Admin emails (comma-separated): these accounts see the 'Access log' screen and the 'Reset demo' button
ADMIN_EMAILS=

# Local testing only: opens the app without Google sign-in. Never put this in the deployed Secrets.
# DEMO_AUTH=off
# DEMO_DEV_EMAIL=you@example.com
